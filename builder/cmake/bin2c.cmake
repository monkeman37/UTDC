# Generates a C source embedding the Dreamcast runner payload.
# Usage: cmake -DIN_BOOT=<1ST_READ.BIN> -DIN_IP=<IP.BIN> -DOUT=<file.c> -P bin2c.cmake
function(emit_array var path out)
  if(EXISTS "${path}")
    file(READ "${path}" hex HEX)
    string(LENGTH "${hex}" hexlen)
    math(EXPR size "${hexlen} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," body "${hex}")
    string(REGEX REPLACE "((0x..,){32})" "\\1\n" body "${body}")
  else()
    set(size 0)
    set(body "0")
  endif()
  file(APPEND "${out}" "const uint8_t ${var}[] = {\n${body}\n};\nconst uint32_t ${var}_size = ${size};\n")
endfunction()
file(WRITE "${OUT}" "/* generated by bin2c.cmake - do not edit */\n#include <stdint.h>\n")
emit_array(utdc_payload_1st_read "${IN_BOOT}" "${OUT}")
emit_array(utdc_payload_ip_bin "${IN_IP}" "${OUT}")
